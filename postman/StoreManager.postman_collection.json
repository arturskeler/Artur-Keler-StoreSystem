    {
      "name": "02. Users - Get",
      "item": [
        {
          "name": "GET [200] Get All Users - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Админ получает список всех пользователей\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "    const res = pm.response.json();\r",
                  "    pm.expect(res).to.be.an(\"array\");\r",
                  "\r",
                  "    // Находим UUID созданного юзера для использования в следующих тестах\r",
                  "    const target = res.find(u => u.email === pm.environment.get(\"user_email\"));\r",
                  "    if (target) {\r",
                  "        pm.environment.set(\"targetUserId\", target.id);\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                ""
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET [403] Get All Users - Regular User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Обычный юзер: 200\", () => pm.response.to.have.status(200));\r",
                  "const res = pm.response.json();\r",
                  "const list = Array.isArray(res) ? res : [res];\r",
                  "pm.test(\"Видит только себя\", () => {\r",
                  "    pm.expect(list).to.have.lengthOf(1);\r",
                  "    pm.expect(list[0].email).to.eql(pm.environment.get(\"user_email\"));\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
