    {
      "name": "02. Users - Get",
      "item": [
        {
          "name": "GET [200] Get All Users - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Админ получает список всех пользователей\", function () {\r\n    pm.response.to.have.status(200);\r\n    const res = pm.response.json();\r\n    pm.expect(res).to.be.an(\"array\");\r\n\r\n    // Находим UUID созданного юзера для использования в следующих тестах\r\n    const target = res.find(u => u.email === pm.environment.get(\"user_email\"));\r\n    if (target) {\r\n        pm.environment.set(\"targetUserId\", target.id);\r\n    }\r\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                ""
              ]
            }
